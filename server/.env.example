PORT=3010
ALLOWED_ORIGIN=https://adenismind-netizen.github.io
# Keep this file outside the public GitHub Pages directory. chmod 600 .env
# Trusted release directory containing quiz-engine.js and quiz-content.js:
QUIZ_SOURCE_DIR=/opt/aden-quiz-api/quiz-source
DATA_DIR=/var/lib/aden-quiz-api
# Generate a stable random local value; do not change while cooldown records exist.
RATE_HASH_KEY=
WASENDER_API_KEY=
TG_TOKEN=
TG_CHAT=
SUPABASE_URL=
# Existing insert-only anon key is supported; never invent a service-role key.
SUPABASE_KEY=
SUPABASE_TABLE=quiz_leads
